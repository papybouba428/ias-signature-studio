  {
   "id": "exp-b-0",
   "type": "text",
   "x": 1620,
   "y": 12,
   "width": 672.0,
   "height": 300.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
